{
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Edit(.env*)",
      "Bash(cat .env*)",
      "Bash(echo.*env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/detect-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
